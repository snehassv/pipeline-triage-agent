# Copy to agent/.env (gitignored) and fill in. Only the agent reads this file —
# unlike the repo-root .env, which docker compose passes into every Airflow container.

# Turns on diagnosis. Create one at console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=

# Claude model used for diagnosis.
AGENT_MODEL=claude-sonnet-5

# owner/name of the repo the Raise PR button targets. Leave empty to disable PRs.
GITHUB_REPO=

# Fixed token for the dashboard/API. Leave empty to generate one per run.
AGENT_TOKEN=
